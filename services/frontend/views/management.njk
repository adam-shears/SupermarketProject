{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/management.css" />
{% endblock %}

{% block content %}
<div class="management-page">
  <div class="management-header">
    <div class="management-title-block">
      <h1>Management View</h1>
      <p class="management-page-subtitle">Store performance, staffing, promotions, and operational overview.</p>
    </div>

    <div class="management-controls">
      <form action="/management" method="get" class="management-filter-form">
        <div class="filter-row">
          <div class="filter-group">
            <label for="scale">Time Scale</label>
            <select name="scale" id="scale" onchange="this.form.submit()">
              <option value="day" {% if scale == "day" %}selected{% endif %}>Day</option>
              <option value="week" {% if scale == "week" %}selected{% endif %}>Week</option>
              <option value="month" {% if scale == "month" %}selected{% endif %}>Month</option>
            </select>
          </div>

          <div class="filter-group">
            <label for="search">Search</label>
            <input
              type="text"
              name="search"
              id="search"
              placeholder="Search by name or category"
              value="{{ search }}"
            >
          </div>

          <button type="submit" class="filter-button">Search</button>
        </div>
      </form>

      <div class="management-export-buttons">
        <a href="/management/export.csv?scale={{ scale }}&search={{ search }}" class="export-button">
          Download CSV
        </a>
      </div>
    </div>
  </div>

  {% if error %}
    <div class="error-message">
      <p>{{ error }}</p>
    </div>
  {% endif %}

  {% if managementActionError %}
    <div class="error-message">
      <p>{{ managementActionError }}</p>
    </div>
  {% endif %}

  {% if staffRegisterSuccess %}
    <div class="success-message">
      <p>Staff registration request submitted.</p>
    </div>
  {% endif %}

  {% if assignSuccess %}
    <div class="success-message">
      <p>Picker assignment request submitted.</p>
    </div>
  {% endif %}

  {% if promoSuccess %}
    <div class="success-message">
      <p>Promo code creation request submitted.</p>
    </div>
  {% endif %}

  {% if discountSuccess %}
    <div class="success-message">
      <p>Discount creation request submitted.</p>
    </div>
  {% endif %}

  <div class="management-grid">
    <div class="management-card total-sales-card">
      <div class="card-header-row">
        <div>
          <h2>Total Sales</h2>
          <p class="card-subtitle">Filtered by {{ scale }}</p>
        </div>
        <span class="card-chip">{{ scale | upper }}</span>
      </div>

      <p class="total-sales-value">&pound;{{ (management.totalSalesPence / 100).toFixed(2) }}</p>
    </div>

    <div class="management-card">
      <div class="card-header-row">
        <div>
          <h2>Best Sellers</h2>
          <p class="card-subtitle">Top-selling products for this {{ scale }}</p>
        </div>
        <span class="card-chip">Top {{ management.bestSellers.length }}</span>
      </div>

      {% if management.bestSellers.length > 0 %}
        <div class="best-sellers-list">
          {% for item in management.bestSellers %}
            <div class="best-seller-item">
              <div class="best-seller-rank">#{{ loop.index }}</div>
              <div class="best-seller-name">{{ item.name }}</div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="no-data">No best seller data available.</p>
      {% endif %}
    </div>

    <div class="management-card">
      <div class="card-header-row">
        <div>
          <h2>Sales by Category</h2>
          <p class="card-subtitle">Revenue grouped by category</p>
        </div>
      </div>

      {% if management.salesPerCategory.length > 0 %}
        <div class="data-list">
          {% for item in management.salesPerCategory %}
            <div class="data-row">
              <span>{{ item.category }}</span>
              <span>&pound;{{ (item.salesPence / 100).toFixed(2) }}</span>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="no-data">No category sales available.</p>
      {% endif %}
    </div>

    <div class="management-card">
      <div class="card-header-row">
        <div>
          <h2>Trending Items</h2>
          <p class="card-subtitle">Items with stronger than usual performance this {{ scale }}</p>
        </div>
      </div>

      {% if management.trendingItems.length > 0 %}
        <div class="data-list">
          {% for item in management.trendingItems %}
            <div class="data-row">
              <span>#{{ item.rank }} {{ item.name }}</span>
              <span>{{ item.unitsSold }} units</span>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <p class="no-data">No trending items found.</p>
      {% endif %}
    </div>
  </div>

  <div class="management-section-grid">
    <div class="management-card">
      <div class="card-header-row">
        <div>
          <h2>Register Staff Member</h2>
          <p class="card-subtitle">Create a new staff account from the management view</p>
        </div>
      </div>

      <form action="/management/staff/register" method="post" class="management-form">
        <div class="management-form-grid">
          <div class="management-form-group">
            <label for="first_name">First name</label>
            <input id="first_name" name="first_name" type="text" required>
          </div>

          <div class="management-form-group">
            <label for="last_name">Last name</label>
            <input id="last_name" name="last_name" type="text" required>
          </div>

          <div class="management-form-group management-form-group--full">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="new.staff@supermarket.com" required>
          </div>

          <div class="management-form-group">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required>
          </div>

          <div class="management-form-group">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="text">
          </div>

          <div class="management-form-group">
            <label for="admin_level">Admin level</label>
            <select id="admin_level" name="admin_level">
              <option value="1">Staff</option>
              <option value="2" selected>Picker / Manager access</option>
              <option value="3">Admin</option>
            </select>
          </div>
        </div>

        <button type="submit" class="management-button">Register Staff</button>
      </form>
    </div>

    <div class="management-card">
      <div class="card-header-row">
        <div>
          <h2>Assign Picker to Order</h2>
          <p class="card-subtitle">Allocate a picker to one of the seeded real orders</p>
        </div>
      </div>

      {% if assignmentOrders.length > 0 %}
        <div class="management-table-wrapper">
          <table class="management-table">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Status</th>
                <th>Assign Picker</th>
              </tr>
            </thead>
            <tbody>
              {% for order in assignmentOrders %}
                <tr>
                  <td>#{{ order.id }}</td>
                  <td>{{ order.customer }}</td>
                  <td><span class="status-badge">{{ order.status }}</span></td>
                  <td>
                    <form action="/management/orders/{{ order.id }}/assign" method="post" class="assign-inline-form">
                      <select name="picker_email" required>
                        <option value="">Select picker</option>
                        {% for picker in pickerOptions %}
                          <option value="{{ picker.value }}">{{ picker.label }}</option>
                        {% endfor %}
                      </select>
                      <button type="submit" class="management-button management-button--small">Assign</button>
                    </form>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p class="no-data">No orders available to assign.</p>
      {% endif %}
    </div>

    <div class="management-card">
      <div class="card-header-row">
        <div>
          <h2>Add Promo Code</h2>
          <p class="card-subtitle">Create a new promo code for the real database flow</p>
        </div>
      </div>

      <form action="/management/promotions/promo-codes" method="post" class="management-form">
        <div class="management-form-grid">
          <div class="management-form-group">
            <label for="promo_code">Code</label>
            <input id="promo_code" name="code" type="text" required>
          </div>

          <div class="management-form-group">
            <label for="promo_name">Name</label>
            <input id="promo_name" name="name" type="text" required>
          </div>

          <div class="management-form-group">
            <label for="promo_type">Type</label>
            <select id="promo_type" name="type">
              <option value="percentage">Percentage</option>
              <option value="fixed">Fixed amount</option>
            </select>
          </div>

          <div class="management-form-group">
            <label for="promo_value">Value</label>
            <input id="promo_value" name="value" type="number" step="0.01" required>
          </div>

          <div class="management-form-group">
            <label for="promo_starts_at">Starts at</label>
            <input id="promo_starts_at" name="starts_at" type="datetime-local" required>
          </div>

          <div class="management-form-group">
            <label for="promo_ends_at">Ends at</label>
            <input id="promo_ends_at" name="ends_at" type="datetime-local" required>
          </div>

          <div class="management-form-group">
            <label for="promo_active">Active</label>
            <select id="promo_active" name="active">
              <option value="true" selected>True</option>
              <option value="false">False</option>
            </select>
          </div>
        </div>

        <button type="submit" class="management-button">Create Promo Code</button>
      </form>
    </div>

    <div class="management-card">
      <div class="card-header-row">
        <div>
          <h2>Add Discount</h2>
          <p class="card-subtitle">Create a new discount entry for the real database flow</p>
        </div>
      </div>

      <form action="/management/promotions/discounts" method="post" class="management-form">
        <div class="management-form-grid">
          <div class="management-form-group">
            <label for="discount_code">Code</label>
            <input id="discount_code" name="code" type="text" required>
          </div>

          <div class="management-form-group">
            <label for="discount_name">Name</label>
            <input id="discount_name" name="name" type="text" required>
          </div>

          <div class="management-form-group">
            <label for="discount_type">Type</label>
            <select id="discount_type" name="type">
              <option value="percentage">Percentage</option>
              <option value="fixed">Fixed amount</option>
            </select>
          </div>

          <div class="management-form-group">
            <label for="discount_value">Value</label>
            <input id="discount_value" name="value" type="number" step="0.01" required>
          </div>

          <div class="management-form-group">
            <label for="discount_starts_at">Starts at</label>
            <input id="discount_starts_at" name="starts_at" type="datetime-local" required>
          </div>

          <div class="management-form-group">
            <label for="discount_ends_at">Ends at</label>
            <input id="discount_ends_at" name="ends_at" type="datetime-local" required>
          </div>

          <div class="management-form-group">
            <label for="discount_active">Active</label>
            <select id="discount_active" name="active">
              <option value="true" selected>True</option>
              <option value="false">False</option>
            </select>
          </div>
        </div>

        <button type="submit" class="management-button">Create Discount</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}