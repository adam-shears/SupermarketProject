{% extends "layout.njk" %}

{% block styles %}
<link rel = "stylesheet" href = "/product.css" />
{% endblock %}

{% block content %}

  <div class="back">
    <a href="/">&larr; Back</a>
  </div>

  <div class="product-section">
    <div class="product-container">
      <div class="product-image">
        <img src="https://via.placeholder.com/400" alt="{{ product.name }}" />
      </div>

      <div class="product-info">
        <h1>{{ product.name }}</h1>
        <p>{{ product.description }}</p>

        <p class="price">&pound;{{ (product.price_pence / 100).toFixed(2) }}</p>

        <div class="quantity">
          <label>Quantity</label>
          <input type="number" value="1" min="1" />
        </div>

        <form action = "/basket/items" method = "POST">
          <input type = "hidden" name = "productId" value = "{{ product.id }}">
          <div class = "quantity">
            <h3>Quantity</h3>
            <input type = "number" name = "quantity" value = "1" min = "1" />
          </div>
          <button type = "submit">Add to Basket</button>
        </form>
        
        {% if product.discounts and product.discounts.length > 0 %}
        <div class="offer">Offer Available</div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="recommend-section">
    <h2>You might also like</h2>

    <div class="recommend-list">
      {% for item in recommendations %}
      <div class="recommend-item">
        <a href="/products/{{ item.id }}">
          <h3>{{ item.name }}</h3>
        </a>
        <p>&pound;{{ (item.price_pence / 100).toFixed(2) }}</p>
      </div>
      {% endfor %}
    </div>
  </div>

{% endblock %}
