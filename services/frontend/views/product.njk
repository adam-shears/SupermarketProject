{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/product.css" />
{% endblock %}

{% block content %}

<div class="main-content">
  <div class="left-column">
    <div class="back">
      <a href="{{ backlink }}">&larr; {{ backtext }}</a>
    </div>

    <div class="product-container">
      <div class="product-image">
        <img
          src="/images/products/{{ product.id }}.JPG"
          alt="{{ product.name }}"
        />
      </div>

      <div class="product-info">
        <h1 class="product-name">{{ product.name }}</h1>
        <p class="product-description">{{ product.description }}</p>

        <p class="price">
          <span class="price-value">&pound;{{ (product.price_pence / 100) | toFixed(2) }}</span>
        </p>

        <form
          class="basket-form main-basket-form"
          data-id="{{ product.id }}"
          data-name="{{ product.name }}"
          data-price="{{ product.price_pence }}"
          data-image="/images/products/{{ product.id }}.JPG"
        >
          <div class="quantity">
            <button
              type="button"
              class="quantity-minus"
              aria-label="Decrease quantity for {{ product.name }}"
            >
              -
            </button>

            <label for="quantity-main" class="visually-hidden">
              Quantity for {{ product.name }}
            </label>
            <input
              type="number"
              id="quantity-main"
              name="quantity"
              value="1"
              min="1"
              class="quantity-input"
              readonly
            />

            <button
              type="button"
              class="quantity-plus"
              aria-label="Increase quantity for {{ product.name }}"
            >
              +
            </button>
          </div>

          <button type="submit" class="add-btn">Add to Basket</button>
        </form>

        {% if product.discounts and product.discounts.length > 0 %}
          {% for discount in product.discounts %}
            {% if discount.code %}
              <div class="offer">Promo Code: {{ discount.code }} - {{ discount.name }}</div>
            {% else %}
              <div class="offer">Offer Available: {{ discount.name }}</div>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>

  {% if recommendations and recommendations.length > 0 %}
    <aside class="recommend-section" aria-labelledby="recommendations-title">
      <h2 id="recommendations-title">You might also like</h2>

      <div class="recommend-list">
        {% for item in recommendations %}
          <article class="recommend-item">
            <a class="product-link" href="/products/{{ item.id }}?from={{ product.id }}">
              <h3 class="recommend-name">{{ item.name }}</h3>
            </a>

            <p class="price">
              <span class="price-value">&pound;{{ (item.price_pence / 100) | toFixed(2) }}</span>
            </p>

            <form
              class="basket-form recommend-buttons"
              data-id="{{ item.id }}"
              data-name="{{ item.name }}"
              data-price="{{ item.price_pence }}"
              data-image="/images/products/{{ item.id }}.JPG"
            >
              <div class="quantity">
                <button
                  type="button"
                  class="quantity-minus"
                  aria-label="Decrease quantity for {{ item.name }}"
                >
                  -
                </button>

                <label for="quantity-{{ item.id }}" class="visually-hidden">
                  Quantity for {{ item.name }}
                </label>
                <input
                  type="number"
                  id="quantity-{{ item.id }}"
                  name="quantity"
                  value="1"
                  min="1"
                  class="quantity-input"
                  readonly
                />

                <button
                  type="button"
                  class="quantity-plus"
                  aria-label="Increase quantity for {{ item.name }}"
                >
                  +
                </button>
              </div>

              <button type="submit" class="add-btn" aria-live="polite" aria-label="Add {{ item.name }} to basket">Add</button>
            </form>

          </article>
        {% endfor %}
      </div>
    </aside>
  {% endif %}
</div>

<script type="module">
  import * as service from "/service.js";

  function normaliseQuantity(input) {
    let value = parseInt(input.value, 10) || 1;
    if (value < 1) value = 1;
    input.value = value;
    return value;
  }

  document.querySelectorAll(".quantity-minus").forEach((button) => {
    button.addEventListener("click", () => {
      const quantityInput = button.parentElement.querySelector(".quantity-input");
      quantityInput.stepDown();
      normaliseQuantity(quantityInput);
    });
  });

  document.querySelectorAll(".quantity-plus").forEach((button) => {
    button.addEventListener("click", () => {
      const quantityInput = button.parentElement.querySelector(".quantity-input");
      quantityInput.stepUp();
      normaliseQuantity(quantityInput);
    });
  });

  document.querySelectorAll(".basket-form").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const productId = Number(form.dataset.id);
      const name = form.dataset.name;
      const price_pence = Number(form.dataset.price);
      const image_url = form.dataset.image || "https://via.placeholder.com/400";

      const quantityInput = form.querySelector(".quantity-input");
      const quantity = normaliseQuantity(quantityInput);

      const addButton = form.querySelector(".add-btn");

      await service.addToBasket(productId, quantity, name, price_pence, image_url);

      const originalText = addButton.textContent;
        addButton.textContent = 'Added!';
        addButton.disabled = true;

        setTimeout(() => {
          addButton.textContent = originalText;
          addButton.disabled = false;
        }, 800);
    });
  });
</script>

{% endblock %}
