{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/product.css" />
{% endblock %}

{% block content %}

<div class = "main-content">

  <div class="left-column">
    <div class="back">
      <a href="{{ backlink }}">&larr; {{ backtext }}</a>
    </div>

    <div class="product-container">
      <div class="product-image">
        <img src="https://via.placeholder.com/400" alt="{{ product.name }}" />
      </div>

      <div class="product-info">
        <h1 class="product-name">{{ product.name }}</h1>
        <p class="product-description">{{ product.description }}</p>

        <p class="price">&pound;{{ (product.price_pence / 100) | toFixed(2) }}</p>

        <!-- Updated form to use JS service -->
        <form id="add-to-basket-form">
          <input type="hidden" id="product-id" value="{{ product.id }}">
          <input type="hidden" id="product-name" value="{{ product.name }}">
          <input type="hidden" id="product-price" value="{{ product.price_pence }}">
          <input type="hidden" id="product-image" value="https://via.placeholder.com/400">

          <div class="quantity">
            <button type="button" class="quantity-minus" onclick="this.parentNode.querySelector('.quantity-input').stepDown()">-</button>
            <input type="number" id="quantity" value="1" min="1" class="quantity-input" readonly/>
            <button type="button" class="quantity-plus" onclick="this.parentNode.querySelector('.quantity-input').stepUp()">+</button>
          </div>

          <button type="submit" class="add-btn">Add to Basket</button>
        </form>
        <p id="add-success" style="display:none;color:green;">Added to basket!</p>
        <p id="report-success" style="display:none;color:green;">Reported stock issue.</p>
        <p id="report-failed" style="display:none;color:red;">Could not report stock issue.</p>

        <button id="report-stock-issue" type="button" class="report-btn">Mark as Unavailable</button>

        {% if product.discounts and product.discounts.length > 0 %}
        <div class="offer">Offer Available</div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="recommend-section">
    <h2>You might also like</h2>

    <div class="recommend-list">
      {% for item in recommendations %}
      <div class="recommend-item">
        <a class="product-link" href="/products/{{ item.id }}?from={{ product.id }}">
          <h3 class="product-name">{{ item.name }}</h3>
        </a>
        <p class="price">&pound;{{ (item.price_pence / 100) | toFixed(2) }}</p>
        <form id="add-to-basket-form" class="recommend-buttons">
          <input type="hidden" id="product-id" value="{{ product.id }}">
          <input type="hidden" id="product-name" value="{{ product.name }}">
          <input type="hidden" id="product-price" value="{{ product.price_pence }}">
          <input type="hidden" id="product-image" value="https://via.placeholder.com/400">

          <div class="quantity">
            <button type="button" class="quantity-minus" onclick="this.parentNode.querySelector('.quantity-input').stepDown()">-</button>
            <input type="number" id="quantity" value="1" min="1" class="quantity-input" readonly/>
            <button type="button" class="quantity-plus" onclick="this.parentNode.querySelector('.quantity-input').stepUp()">+</button>
          </div>

          <button type="submit" class="add-btn">Add to Basket</button>
        </form>
        <p id="add-success" style="display:none;color:green;">Added to basket!</p>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<!-- Frontend JS to handle basket -->
<script type="module">
  import * as service from '/service.js'; 

  const form = document.getElementById("add-to-basket-form");
  const successMsg = document.getElementById("add-success");

  form.addEventListener("submit", (e) => {
    e.preventDefault(); // prevent normal form submit

    const productId = Number(document.getElementById("product-id").value);
    const name = document.getElementById("product-name").value;
    const price_pence = Number(document.getElementById("product-price").value);
    const image_url = document.getElementById("product-image").value;
    const quantity = Number(document.getElementById("quantity").value);

    // Used service.js to add to basket
    service.addToBasket(productId, quantity, name, price_pence, image_url);

    // Show confirmation
    successMsg.style.display = "block";
    setTimeout(() => successMsg.style.display = "none", 2000);
  });

  const reportButton = document.getElementById('report-stock-issue');
  const reportSuccess = document.getElementById('report-success');
  const reportFailed = document.getElementById('report-failed');

  if (reportButton) {
    reportButton.addEventListener('click', async () => {
      const productId = Number(document.getElementById("product-id").value);

      reportSuccess.style.display = 'none';
      reportFailed.style.display = 'none';

      try {
        // reporterId is taken from session user on backend, but we still pass placeholder to satisfy API shape.
        await service.reportStockIssue(productId, 0, 'Reported through UI');
        reportSuccess.style.display = 'block';
      } catch (error) {
        console.error(error);
        reportFailed.style.display = 'block';
      }

      setTimeout(() => {
        reportSuccess.style.display = 'none';
        reportFailed.style.display = 'none';
      }, 3000);
    });
  }
</script>

{% endblock %}