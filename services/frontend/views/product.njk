{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/product.css" />
{% endblock %}

{% block content %}
<div class="back">
  <a href="/">&larr; Back</a>
</div>

<div class="product-section">
  <div class="product-container">
    <div class="product-image">
      <img src="https://via.placeholder.com/400" alt="{{ product.name }}" />
    </div>

    <div class="product-info">
      <h1>{{ product.name }}</h1>
      <p>{{ product.description }}</p>
      <p class="price">&pound;{{ (product.price_pence / 100) | toFixed(2) }}</p>

      <form id="add-to-basket-form">
        <input type="hidden" id="product-id" value="{{ product.id }}">
        <input type="hidden" id="product-name" value="{{ product.name }}">
        <input type="hidden" id="product-price" value="{{ product.price_pence }}">
        <input type="hidden" id="product-image" value="https://via.placeholder.com/400">

        <div class="quantity">
          <h3>Quantity</h3>
          <input type="number" id="quantity" value="1" min="1" />
        </div>

        <button type="submit">Add to Basket</button>
      </form>
      
      <p id="add-feedback" style="display:none; font-weight: bold; margin-top: 10px;"></p>

      {% if product.discounts and product.discounts.length > 0 %}
      <div class="offer">Offer Available</div>
      {% endif %}
    </div>
  </div>
</div>

<script type="module">
  import * as service from '/service.js';
  import { api } from '/api.js';

  const form = document.getElementById("add-to-basket-form");
  const feedbackMsg = document.getElementById("add-feedback");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    console.log('🔵 Add to basket form submitted');

    // Extract data
    const productId = Number(document.getElementById("product-id").value);
    const name = document.getElementById("product-name").value;
    const price_pence = Number(document.getElementById("product-price").value);
    const image_url = document.getElementById("product-image").value;
    const quantity = Number(document.getElementById("quantity").value);

    console.log(`Adding: ${name} (qty: ${quantity}, productId: ${productId})`);

    try {
      // Call the validated service function (now async)
      const result = await service.addToBasket(productId, quantity, name, price_pence, image_url, window.user, api);

      console.log('Result:', result);

      // Update UI based on validation success or failure
      if (result.success) {
        console.log('✓ Add successful');
        feedbackMsg.textContent = `Added ${quantity} x ${name} to basket!`;
        feedbackMsg.style.color = "green";
      } else {
        console.error('✗ Add failed:', result.message);
        feedbackMsg.textContent = result.message;
        feedbackMsg.style.color = "red";
      }
    } catch (error) {
      console.error('✗ Exception thrown:', error);
      feedbackMsg.textContent = `Error: ${error.message}`;
      feedbackMsg.style.color = "red";
    }

    feedbackMsg.style.display = "block";
    setTimeout(() => feedbackMsg.style.display = "none", 4000);
  });

  console.log('Product detail script loaded');
</script>
{% endblock %}