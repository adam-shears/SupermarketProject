<!DOCTYPE html>
<html>

<head>

<title>{{ product.name }}</title>

<style>

body{
font-family: Arial;
margin:0;
background:#f5f5f5;
}

.header{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px;
background:white;
border-bottom:1px solid #ddd;
}

.search{
width:400px;
padding:8px;
}

.back{
padding:15px 40px;
}

.back a{
text-decoration:none;
color:#3498db;
font-weight:bold;
}

.product-section{
display:flex;
justify-content:center;
padding:40px;
background:white;
margin:30px;
}

.product-container{
display:flex;
width:100%;
max-width:1200px;
}

.product-image{
flex:1;
}

.product-image img{
width:100%;
max-width:400px;
}

.product-info{
flex:1;
padding-left:40px;
}

.price{
font-size:28px;
font-weight:bold;
margin:20px 0;
}

.quantity{
margin-top:20px;
}

button{
margin-top:20px;
padding:12px 25px;
background:#2ecc71;
color:white;
border:none;
font-size:16px;
cursor:pointer;
}

.offer{
margin-top:20px;
color:red;
font-weight:bold;
}

.recommend-section{
margin:30px;
padding:30px;
background:white;
}

.recommend-list{
display:flex;
gap:30px;
}

.recommend-item{
border:1px solid #ddd;
padding:20px;
width:200px;
text-align:center;
background:#fafafa;
}

</style>

</head>

<body>

<div class="header">

<div>
<a href="/">LOGO</a>
</div>

<div>
<input class="search" type="text" placeholder="Search">
</div>

<div>
<a href="#">Login</a>
<a href="#">Basket</a>
</div>

</div>


<div class="back">

<a href="/">← Back</a>

</div>


<div class="product-section">

<div class="product-container">

<div class="product-image">
<img src="https://via.placeholder.com/400">
</div>

<div class="product-info">

<h1>{{ product.name }}</h1>

<p>{{ product.description }}</p>

<p class="price">
£{{ (product.price_pence / 100).toFixed(2) }}
</p>

<div class="quantity">
<label>Quantity</label>
<input type="number" value="1" min="1">
</div>

<button>
Add to Basket
</button>

<div class="offer">
Offer Available
</div>

</div>

</div>

</div>


<div class="recommend-section">

<h2>You might also like</h2>

<div class="recommend-list">

{% for item in recommendations %}

<div class="recommend-item">

<a href="/products/{{ item.id }}">
<h3>{{ item.name }}</h3>
</a>

<p>
£{{ (item.price_pence / 100).toFixed(2) }}
</p>

</div>

{% endfor %}

</div>

</div>

</body>

</html>