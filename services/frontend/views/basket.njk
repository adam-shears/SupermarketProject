{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/basket.css" />
{% endblock %}

{% block content %}

<div class="basket-wrapper">
  <h1 class="basket-title">Your Basket</h1>

  <div class="basket-page">
    <section class="items-column" aria-labelledby="basket-items-title">
      <h2 id="basket-items-title">Your Items</h2>
      <div id="basket-items">
        <!-- Items will be rendered by JavaScript from LocalStorage -->
      </div>
    </section>

    <aside class="summary-column" aria-labelledby="basket-summary-title">
      <h2 id="basket-summary-title">Summary</h2>

      <div class="summary-row">
        <span>Subtotal</span>
        <span id="subtotal-text">&pound;0.00</span>
      </div>

      <div class="summary-row discount-row" id="discount-div" hidden>
        <span>Discount</span>
        <span id="discount-text">-&pound;0.00</span>
      </div>

      <div class="promo">
        <label for="promo-code" class="visually-hidden">Promo code</label>
        <input id="promo-code" type="text" placeholder="Promo code">
        <button type="button" class="promo-btn">Add</button>
        <p id="promo-applied-status" role="status" aria-live="polite" hidden></p>
      </div>

      <div class="summary-row total-row">
        <span>Total</span>
        <span id="total-text">&pound;0.00</span>
      </div>

      <button type="button" class="proceed">Proceed &rarr;</button>

      {% if user %}
        <button type="button" id="open-save-basket-modal" class="proceed">Save this basket</button>
      {% endif %}
      <dialog id="save-basket-modal" class="save-basket-modal">
        <form id="save-basket-form" method="dialog">
          <h2>Save Basket</h2>
          <label for="saved-basket-name">Basket name</label>
          <input id="saved-basket-name" name="name" type="text" maxlength="255" placeholder="Enter basket name here..." required>
          <p id="save-basket-status" role="status" aria-live="polite" hidden></p>
          <div class="modal-actions">
            <button type="button" id="cancel-save-basket" class="cancel">Cancel</button>
            <button type="submit" class="proceed">Save</button>
          </div>
        </form>
      </dialog>
    </aside>
  </div>
</div>

<script type="module">
  import * as service from '/service.js';
  const saveBasketModal = document.getElementById("save-basket-modal");
  const openSaveBasketModal = document.getElementById("open-save-basket-modal");
  const cancelSaveBasketButton = document.getElementById("cancel-save-basket");
  const saveBasketForm = document.getElementById("save-basket-form");
  const saveBasketStatus = document.getElementById("save-basket-status");
  let appliedPromoCode = null;

  openSaveBasketModal?.addEventListener("click", () => {
    saveBasketStatus.hidden = true;
    saveBasketStatus.textContent = "";
    saveBasketModal.showModal();
  });

  cancelSaveBasketButton?.addEventListener("click", () => {
    saveBasketModal.close();
  });

  saveBasketForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const data = new FormData(saveBasketForm);
    const name = String(data.get("name") || "").trim();
    if (!name) return;

    try {
      const res = await fetch("/api/basket/save", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ name }),
      });

      if (!res.ok) throw new Error("Failed to save basket");

      saveBasketStatus.textContent = "Basket saved successfully";
      saveBasketStatus.hidden = false;

      setTimeout(() => {
        saveBasketModal.close();
        saveBasketForm.reset();
      }, 700);
    } catch (error) {
      saveBasketStatus.textContent = "Could not save basket";
      saveBasketStatus.hidden = false;
    }
  });

  function formatPrice(pence) {
    return `£${(pence / 100).toFixed(2)}`;
  }

  async function updateTotals() {
    const totals = await service.calculateTotals(appliedPromoCode);

    document.getElementById('subtotal-text').textContent = formatPrice(totals.subtotal);
    document.getElementById('total-text').textContent = formatPrice(totals.total);

    const discountDiv = document.getElementById('discount-div');
    const discountText = document.getElementById('discount-text');

    if (totals.discounts > 0) {
      discountDiv.hidden = false;
      discountText.textContent = `-${formatPrice(totals.discounts)}`;
    } else {
      discountDiv.hidden = true;
      discountText.textContent = '-£0.00';
    }
  }

  async function renderBasket() {
    const items = await service.getBasket();
    const itemsColumn = document.getElementById('basket-items');
    itemsColumn.innerHTML = '';

    if (items.length === 0) {
      itemsColumn.innerHTML = `
        <p class="empty-basket">Your basket is empty.</p>
      `;
      await updateTotals();
      return;
    }

    items.forEach((item) => {
      itemsColumn.innerHTML += `
        <article class="item-card">
          <a href="/products/${item.productId}?from=basket" class="item-link">
            <img src="${item.image_url}" alt="${item.name}" class="product-thumbnail">
            <div class="item-details">
              <h3 class="item-name">${item.name}</h3>
              <p class="item-price">${formatPrice(item.price_pence)}</p>
            </div>
          </a>

          <div class="item-actions">
            <label for="qty-${item.productId}" class="visually-hidden">
              Quantity for ${item.name}
            </label>
            <input
              id="qty-${item.productId}"
              type="number"
              value="${item.quantity}"
              class="quantity-input"
              data-id="${item.productId}"
              min="1"
            >

            <button
              type="button"
              class="delete-button"
              data-id="${item.productId}"
              aria-label="Remove ${item.name} from basket"
            >
              Remove
            </button>
          </div>
        </article>
      `;
    });

    await attachEventListeners();
    await updateTotals();
  }

  async function attachEventListeners() {
    document.querySelectorAll('.delete-button').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const productId = Number(e.currentTarget.dataset.id);
        await service.removeFromBasket(productId);
        await renderBasket();
      });
    });

    document.querySelectorAll('.quantity-input').forEach((input) => {
      const update = async (e) => {
        const productId = Number(e.target.dataset.id);
        let quantity = parseInt(e.target.value, 10) || 1;

        if (quantity < 1) {
          quantity = 1;
          e.target.value = 1;
        }

        await service.updateQuantity(productId, quantity);
        await updateTotals();
      };

      input.addEventListener('input', update);
      input.addEventListener('change', update);
    });

    document.querySelector('.promo-btn')?.addEventListener('click', async () => {
      const input = document.getElementById('promo-code');
      const promoAppliedStatus = document.getElementById("promo-applied-status")
      promoAppliedStatus.hidden = true;
      appliedPromoCode = input.value.trim() || null;

      try {
        await updateTotals();
        promoAppliedStatus.textContent = "Promo code applied";
        promoAppliedStatus.hidden = false;
      } catch (error) {
        appliedPromoCode = null;
        input.value = '';
        promoAppliedStatus.textContent = "Promo code not found";
        promoAppliedStatus.hidden = false;
        await updateTotals();
      }
    });
  }

  await renderBasket();
</script>

{% endblock %}
