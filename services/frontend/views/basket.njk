{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/basket.css" />
  <style>
    .proceed:disabled { background-color: #ccc; cursor: not-allowed; opacity: 0.6; }
    .cost-row { display: flex; justify-content: space-between; margin: 10px 0; }
    .total-row { font-weight: bold; font-size: 1.2rem; border-top: 2px solid #333; padding-top: 10px; }
  </style>
{% endblock %}

{% block content %}
<div class="basket-page">
    <div class="items-column">
        <h2>Your Items</h2>
        <div id="basket-items"></div>
    </div>

    <div class="summary-column">
        <h2>Order Summary</h2>
        <div class="cost-row">
            <span>Subtotal</span>
            <span id="subtotal-value">£0.00</span>
        </div>
        <div class="cost-row total-row">
            <span>Total</span>
            <span id="total-value">£0.00</span>
        </div>

        <button id="proceed-button" class="proceed" style="width: 100%; padding: 15px; margin-top: 20px; cursor: pointer;">
            Proceed to Checkout &rarr;
        </button>
    </div>
</div>

<script type="module">
  import * as service from '/service.js';

  const proceedBtn = document.getElementById('proceed-button');

  function updateTotals() {
    const totals = service.calculateTotals();
    const isEmpty = service.isBasketEmpty();

    document.getElementById('subtotal-value').textContent = `£${(totals.subtotal / 100).toFixed(2)}`;
    document.getElementById('total-value').textContent = `£${(totals.total / 100).toFixed(2)}`;

    // Disable button if basket is empty
    proceedBtn.disabled = isEmpty;
  }

  function renderBasket() {
    const items = service.getBasket();
    const itemsColumn = document.getElementById('basket-items');
    itemsColumn.innerHTML = '';

    if (items.length === 0) {
      itemsColumn.innerHTML = '<p>Your basket is empty.</p>';
      updateTotals();
      return;
    }

    items.forEach(item => {
      itemsColumn.innerHTML += `
        <div class="item-card" style="display:flex; gap:20px; border-bottom:1px solid #eee; padding:15px 0;">
          <img src="${item.image_url}" width="80">
          <div>
            <h3>${item.name}</h3>
            <p>£${(item.price_pence / 100).toFixed(2)}</p>
            <input type="number" value="${item.quantity}" class="qty-input" data-id="${item.productId}" style="width:50px;">
            <button class="remove-btn" data-id="${item.productId}">Remove</button>
          </div>
        </div>
      `;
    });

    // Handle updates
    document.querySelectorAll('.qty-input').forEach(i => i.onchange = (e) => {
        const res = service.updateQuantity(Number(e.target.dataset.id), e.target.value);
        if(!res.success) alert(res.message);
        renderBasket();
    });

    document.querySelectorAll('.remove-btn').forEach(b => b.onclick = (e) => {
        service.removeFromBasket(Number(e.target.dataset.id));
        renderBasket();
    });

    updateTotals();
  }

  // User Story: "Taken to the next step at once"
  proceedBtn.onclick = () => window.location.href = '/checkout';

  renderBasket();
</script>
{% endblock %}