{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/basket.css" />
{% endblock %}

{% block content %}

<div class="basket-page">
    <div class="items-column">
        <h2>Your Items</h2>
        <div id="basket-items">
            <!-- Items will be rendered by JavaScript from LocalStorage -->
        </div>
    </div>

    <div class="summary-column">
        <h2>Summary</h2>
        <div class="subtotal" id="subtotal-div">
            <h3>Subtotal &pound;0.00</h3>
        </div>
        <div class="discount" id="discount-div" style="display: none;">
            <h3 id="discount-text">Discount -&pound;0.00</h3>
        </div>
        <div class="promo">
            <input type="text" placeholder="Promo">
            <button>Add</button>
        </div>
        <div class="total">
            <h3 id="total-text">Total &pound;0.00</h3>
        </div>

        <button class="proceed">Proceed &rarr;</button>
    </div>
</div>

<script type="module">
  import * as service from '/service.js';

  // Update subtotal, discount, and total in the summary
  function updateTotals() {
    const totals = service.calculateTotals();

    document.getElementById('subtotal-div').innerHTML = `<h3>Subtotal &pound;${(totals.subtotal / 100).toFixed(2)}</h3>`;
    document.getElementById('total-text').textContent = `Total £${(totals.total / 100).toFixed(2)}`;

    if (totals.discounts > 0) {
      document.getElementById('discount-div').style.display = 'block';
      document.getElementById('discount-text').textContent = `Discount -£${(totals.discounts / 100).toFixed(2)}`;
    } else {
      document.getElementById('discount-div').style.display = 'none';
    }
  }

  // Render all basket items
  function renderBasket() {
    const items = service.getBasket();
    const itemsColumn = document.getElementById('basket-items');
    itemsColumn.innerHTML = '';

    if (items.length === 0) {
      itemsColumn.innerHTML = '<p>Your basket is empty</p>';
      updateTotals();
      return;
    }

    items.forEach(item => {
      itemsColumn.innerHTML += `
        <div class="item-card">
          <a href="/products/${item.productId}">
            <img src="${item.image_url}" alt="${item.name}" class="product-thumbnail">
            <div class="item-details">
              <h3>${item.name}</h3>
              <p>&pound;${(item.price_pence / 100).toFixed(2)}</p>
            </div>
          </a>
          <div class="item-actions">
            <input type="number" value="${item.quantity}" class="quantity-input" data-id="${item.productId}" min="1">
            <button class="delete-button" data-id="${item.productId}">X</button>
          </div>
        </div>
      `;
    });

    attachEventListeners();
    updateTotals();
  }

  // Attach event listeners to delete buttons and quantity inputs
  function attachEventListeners() {
    // Delete item
    document.querySelectorAll('.delete-button').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const productId = Number(e.target.dataset.id);
        service.removeFromBasket(productId);
        renderBasket();
      });
    });

    // Quantity change
    document.querySelectorAll('.quantity-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const productId = Number(e.target.dataset.id);
        let quantity = parseInt(e.target.value) || 1;

        if (quantity < 1) {
          quantity = 1;
          e.target.value = 1;
        }

        service.updateQuantity(productId, quantity);
        updateTotals();
      });

      input.addEventListener('change', (e) => {
        const productId = Number(e.target.dataset.id);
        let quantity = parseInt(e.target.value) || 1;

        if (quantity < 1) {
          quantity = 1;
          e.target.value = 1;
        }

        service.updateQuantity(productId, quantity);
        updateTotals();
      });
    });
  }

  // Initial render on page load
  renderBasket();
</script>

{% endblock %}