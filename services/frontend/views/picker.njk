{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/picker.css" />
{% endblock %}

{% block content %}
  <div class="picker-page">
    <h1>Picker View</h1>

    {% if completed %}
      <p class="success-message">Item marked as completed.</p>
    {% endif %}

    {% if issueSubmitted %}
      <p class="success-message">Issue submitted successfully.</p>
    {% endif %}

    {% for order in orders %}
      <section class="order-card">
        <div class="order-summary">
          <div><strong>{{ order.customer_name }}</strong></div>
          <div>{{ order.order_info }}</div>
        </div>

        <div class="order-body">
          <h2>Order {{ order.id }}</h2>
          <p class="customer-name">{{ order.customer_name }}</p>

          <div class="item-list">
            {% for item in order.items %}
              <div class="picker-item {% if item.picked %}picked-item{% endif %}">
                <div class="item-row">
                  <div class="item-name">
                    {{ item.product_name }}
                    {% if item.quantity %}
                      <span class="qty-badge">x{{ item.quantity }}</span>
                    {% endif %}
                    {% if item.picked %}
                      <span class="picked-badge">Picked</span>
                    {% endif %}
                  </div>

                  <div class="item-actions">
                    <form method="POST" action="/picker/orders/{{ order.id }}/items/{{ item.product_id }}/complete">
                      <button type="submit" class="complete-button" {% if item.picked %}disabled{% endif %}>✓</button>
                    </form>

                    <button
                      type="button"
                      class="warning-button"
                      data-target="issue-form-{{ order.id }}-{{ item.product_id }}"
                    >
                      ⚠
                    </button>

                    <div class="location-code">
                      {{ item.location_code }}
                    </div>
                  </div>
                </div>

                <div class="issue-popup hidden" id="issue-form-{{ order.id }}-{{ item.product_id }}">
                  <form method="POST" action="/picker/orders/{{ order.id }}/items/{{ item.product_id }}/issue">
                    <label for="substitute-{{ order.id }}-{{ item.product_id }}">Substituted with</label>
                    <select id="substitute-{{ order.id }}-{{ item.product_id }}" name="substituteProductId">
                      <option value="">Select substitute</option>
                      {% for substitute in item.substitutes %}
                        <option value="{{ substitute.id }}">{{ substitute.name }}</option>
                      {% endfor %}
                    </select>

                    <label for="reason-{{ order.id }}-{{ item.product_id }}">Reason</label>
                    <select id="reason-{{ order.id }}-{{ item.product_id }}" name="reason" required>
                      <option value="">Select reason</option>
                      <option value="out_of_stock">Out of stock</option>
                      <option value="damaged">Damaged</option>
                      <option value="missing">Missing</option>
                      <option value="wrong_item">Wrong item</option>
                    </select>

                    <div class="issue-popup-actions">
                      <button type="submit" class="submit-issue-button">Submit</button>
                      <button type="button" class="cancel-issue-button">Cancel</button>
                    </div>
                  </form>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endfor %}
  </div>

  <script type="module" src="/picker.js"></script>
{% endblock %}