{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/product-list.css" />
{% endblock %}

{% block content %}

<div class="product-list-page">
  <h1>{{ title }}</h1>

  <div class="products-grid">
    {% for product in products %}
    <div class="product-card">

      <!-- Clickable product (navigates to product details page) -->
      <a href="/products/{{ product.id }}?from={{ encodedCategory }}">
        <div class="image-container">
          <img src="{{ product.image_url | default('https://via.placeholder.com/200') }}" alt="{{ product.name }}">
          <h3>{{ product.name }}</h3>
          <p>&pound;{{ (product.price_pence / 100) | toFixed(2) }}</p>
        </div>
      </a>

      <!-- Display offer if product has discounts -->
      {% if product.discounts and product.discounts.length > 0 %}
        <div class="offer">Offer Available</div>
      {% endif %}

      <!-- Basket controls -->
      <div class="basket-controls">
        <!-- Quantity input -->
        <div class="quantity-selector">
          <button type="button" class="quantity-minus" onclick="this.parentNode.querySelector('.quantity-input').stepDown()">-</button>
          <input 
            type="number" 
            value="1" 
            min="1" 
            class="quantity-input"
            readonly
          />
          <button type="button" class="quantity-plus" onclick="this.parentNode.querySelector('.quantity-input').stepUp()">+</button>
        </div>

        <!-- Add to basket button with product data stored in data-* attributes -->
        <button 
          class="add-btn"
          data-id="{{ product.id }}"
          data-name="{{ product.name }}"
          data-price="{{ product.price_pence }}"
          data-image="{{ product.image_url }}">
          Add
        </button>
      </div>

    </div>
    {% endfor %}
  </div>
</div>

<!-- JavaScript module -->
<script type="module">
  // Import all basket-related functions from service.js
  import * as service from '/service.js';

  // Function to attach event listeners to all "Add to Basket" buttons
  function attachEventListeners() {

    // Select all buttons with class 'add-btn'
    document.querySelectorAll('.add-btn').forEach(btn => {

      // Add click event listener to each button
      btn.addEventListener('click', () => {

        // Extract product data from button's data attributes
        const productId = Number(btn.dataset.id); // Convert to number for consistency
        const name = btn.dataset.name;
        const price = Number(btn.dataset.price);
        const image = btn.dataset.image || 'https://via.placeholder.com/200';

        // Find the quantity input within the same product card
        const quantityInput = btn.parentElement.querySelector('.quantity-input');

        // Get quantity value and ensure it's valid
        let quantity = parseInt(quantityInput.value) || 1;

        // Prevent invalid quantities (e.g. 0 or negative numbers)
        if (quantity < 1) {
          quantity = 1;
          quantityInput.value = 1;
        }

        // Call service function to add item to basket (stored in LocalStorage)
        service.addToBasket(productId, quantity, name, price, image);

        // Provide feedback to the user
        const originalText = btn.textContent;
        btn.textContent = 'Added!';
        btn.disabled = true;

        // Reset button after 1.5 seconds
        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
        }, 1500);
      });
    });
  }

  // Run function when page loads to activate buttons
  attachEventListeners();
</script>

{% endblock %}