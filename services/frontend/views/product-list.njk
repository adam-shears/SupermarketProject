{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/product-list.css" />
{% endblock %}

{% block content %}
<h1>All Products</h1>

<div class="products-grid">
  {% for product in products %}
  <div class="product-card">
    <a href="/products/{{ product.id }}">
      <img src="{{ product.image_url || 'https://via.placeholder.com/200' }}" alt="{{ product.name }}">
      <h3>{{ product.name }}</h3>
      <p>&pound;{{ (product.price_pence / 100).toFixed(2) }}</p>
    </a>
    {% if product.discounts and product.discounts.length > 0 %}
      <div class="offer">Offer Available</div>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endblock %}