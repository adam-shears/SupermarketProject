{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/product-list.css" />
{% endblock %}

{% block content %}
<div class="product-list-page">
  <h1>All Products</h1>
  <div class="products-grid">
    {% for product in products %}
    <div class="product-card">
      <a href="/products/{{ product.id }}">
        <img src="{{ product.image_url | default('https://via.placeholder.com/200') }}" alt="{{ product.name }}">
        <h3>{{ product.name }}</h3>
        <p>&pound;{{ (product.price_pence / 100) | toFixed(2) }}</p>
      </a>

      <div class="basket-controls">
        <input type="number" value="1" min="1" class="quantity-input" />
        <button class="add-btn" 
                data-id="{{ product.id }}" 
                data-name="{{ product.name }}" 
                data-price="{{ product.price_pence }}" 
                data-image="{{ product.image_url }}">
          Add to Basket
        </button>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<script type="module">
  import * as service from '/service.js';
  import * as api from '/api.js';

  function attachEventListeners() {
    document.querySelectorAll('.add-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const productId = Number(btn.dataset.id);
        const name = btn.dataset.name;
        const price = Number(btn.dataset.price);
        const image = btn.dataset.image;
        const quantityInput = btn.parentElement.querySelector('.quantity-input');
        const quantity = parseInt(quantityInput.value);

        const result = await service.addToBasket(productId, quantity, name, price, image, window.user, api);

        if (result.success) {
          alert(`Added ${quantity} x ${name} to basket!`);
        } else {
          alert(`Error: ${result.message}`);
          quantityInput.value = 1; // Reset on error
        }
      });
    });
  }

  attachEventListeners();
</script>
{% endblock %}