{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/product-list.css" />
{% endblock %}

{% block content %}

<div class="product-list-page">
  <div class="hero-banner">
    <p class="banner-text">Fresh Groceries, Delivered.</p>
    <p>Shop our latest arrivals and seasonal favorites.</p>
  </div>

  {% if searchTerm %}
    <h1>Search results for "{{ searchTerm }}"</h1>
  {% elif category %}
    <h1>{{ category }}</h1>
  {% else %}
    <h1>All Products</h1>
  {% endif %}

  {% if products.length === 0 %}
    <p>No matches</p>
    <p>Check the spelling or try searching for something else.</p>
    <a href="/products">Browse full catalogue</a>
  {% else %}
    <div class="products-grid">
      {% for product in products %}
      <article class="product-card">
        <a
          href="/products/{{ product.id }}?from={{ encodedCategory }}"
          class="product-card-link"
        >
          <div class="product-details">
            <img
              class="product-image"
              src="/images/products/{{ product.id }}.JPG"
              alt="{{product.name}}"
            >
            <span class="product-name">{{ product.name }}</span>
            <p class="product-price">&pound;{{ (product.price_pence / 100) | toFixed(2) }}</p>
          </div>
        </a>

        {% if product.discounts and product.discounts.length > 0 %}
          <div class="offer">Offer Available</div>
        {% endif %}

        <div class="basket-controls">
          <div class="quantity-selector">
            <button
              type="button"
              class="quantity-minus"
              aria-label="Decrease quantity for {{ product.name }}"
              onclick="this.parentNode.querySelector('.quantity-input').stepDown()"
            >
              -
            </button>

            <label for="quantity-{{ product.id }}" class="visually-hidden">
              Quantity for {{ product.name }}
            </label>
            <input
              id="quantity-{{ product.id }}"
              type="number"
              value="1"
              min="1"
              class="quantity-input"
              readonly
            />

            <button
              type="button"
              class="quantity-plus"
              aria-label="Increase quantity for {{ product.name }}"
              onclick="this.parentNode.querySelector('.quantity-input').stepUp()"
            >
              +
            </button>
          </div>

          <button
            type="button"
            class="add-btn"
            aria-live="polite"
            aria-label="Add {{ product.name }} to basket"
            data-id="{{ product.id }}"
            data-name="{{ product.name }}"
            data-price="{{ product.price_pence }}"
            data-image="/images/products/{{ product.id }}.JPG"
          >
            Add
          </button>
        </div>
      </article>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script type="module">
  import * as service from '/service.js';

  async function attachEventListeners() {
    document.querySelectorAll('.add-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const productId = Number(btn.dataset.id);
        const name = btn.dataset.name;
        const price = Number(btn.dataset.price);
        const image = btn.dataset.image || 'https://via.placeholder.com/200';

        const card = btn.closest('.product-card');
        const quantityInput = card.querySelector('.quantity-input');

        let quantity = parseInt(quantityInput.value, 10) || 1;

        if (quantity < 1) {
          quantity = 1;
          quantityInput.value = 1;
        }

        await service.addToBasket(productId, quantity, name, price, image);

        const originalText = btn.textContent;
        btn.textContent = 'Added!';


        setTimeout(() => {
          btn.textContent = originalText;

        }, 800);
      });
    });
  }

  await attachEventListeners();
</script>

{% endblock %}
