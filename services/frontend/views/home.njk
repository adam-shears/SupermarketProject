{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/home.css" />
{% endblock %}

{% block content %}
<div class="home-wrapper">

    <section class="banner-box" aria-labelledby="home-banner-title">
        <div class="banner-text">
            <h1 id="home-banner-title">Fresh Groceries</h1>
            <p>From our warehouse to your house.</p>
            <a href="/products" class="shop-link">View all products</a>
        </div>
    </section>

    <div class="content-area">
        <div class="button-row">
            <a href="/account/orders/repeat" class="action-card" aria-label="Repeat your last order">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="action-icon" aria-hidden="true">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                </svg>
                <div>Repeat Last Order</div>
            </a>

            <a href="/baskets/saved" class="action-card" aria-label="View your saved baskets">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="action-icon" aria-hidden="true">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <div>Saved Baskets</div>
            </a>

            <a href="/loyalty" class="action-card" aria-label="View your loyalty card">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="action-icon" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M12 9l.9 2.2 2.3.2-1.7 1.5.5 2.3-2-1.2-2 1.2.5-2.3-1.7-1.5 2.3-.2L12 9z"></path>
                </svg>
                <div>Loyalty Card</div>
            </a>
        </div>

        <section class="category-area" aria-labelledby="shop-by-category-title">
            <div class="category-title-bar">
                <h2 id="shop-by-category-title">
                    Shop by category |
                    <a href="/products">All products</a>
                </h2>
            </div>

            <div class="grid-container">
                <a href="/products?category=Groceries%20%26%20Essentials" class="cat-item" aria-label="Browse Groceries and Essentials">
                    <img class="category-image" src="/images/categories/groceries-essentials.JPG" alt="Groceries & Essentials" />
                    <span>Groceries &amp; Essentials</span>
                </a>

                <a href="/products?category=Fresh%20Food" class="cat-item" aria-label="Browse Fresh Food">
                    <img class="category-image" src="/images/categories/fresh-food.JPG" alt="Fresh Food" />
                    <span>Fresh Food</span>
                </a>

                <a href="/products?category=Bakery" class="cat-item" aria-label="Browse Bakery">
                    <img class="category-image" src="/images/categories/bakery.JPG" alt="Bakery" />
                    <span>Bakery</span>
                </a>

                <a href="/products?category=Frozen%20Food" class="cat-item" aria-label="Browse Frozen Food">
                    <img class="category-image" src="/images/categories/frozen-food.JPG" alt="Frozen Food" />
                    <span>Frozen Food</span>
                </a>

                <a href="/products?category=Treats%20%26%20Snacks" class="cat-item" aria-label="Browse Treats and Snacks">
                    <img class="category-image" src="/images/categories/treats-snacks.JPG" alt="Treats & Snacks" />
                    <span>Treats &amp; Snacks</span>
                </a>

                <a href="/products?category=Drinks" class="cat-item" aria-label="Browse Drinks">
                    <img class="category-image" src="/images/categories/drinks.JPG" alt="Drinks" />
                    <span>Drinks</span>
                </a>

                <a href="/products?category=Baby%20%26%20Toddler" class="cat-item" aria-label="Browse Baby and Toddler products">
                    <img class="category-image" src="/images/categories/baby-toddler.JPG" alt="Baby & Toddler" />
                    <span>Baby &amp; Toddler</span>
                </a>

                <a href="/products?category=Health%20%26%20Beauty" class="cat-item" aria-label="Browse Health and Beauty products">
                    <img class="category-image" src="/images/categories/health-beauty.JPG" alt="Health & Beauty" />
                    <span>Health &amp; Beauty</span>
                </a>

                <a href="/products?category=Pets" class="cat-item" aria-label="Browse Pet products">
                    <img class="category-image" src="/images/categories/pets.JPG" alt="Pets" />
                    <span>Pets</span>
                </a>

                <a href="/products?category=Household%20%26%20Cleaning" class="cat-item" aria-label="Browse Household and Cleaning products">
                    <img class="category-image" src="/images/categories/household-cleaning.JPG" alt="Household & Cleaning" />
                    <span>Household &amp; Cleaning</span>
                </a>
            </div>
        </section>
    </div>
</div>
{% endblock %}
