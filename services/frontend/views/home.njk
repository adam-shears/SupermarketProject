{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/home.css" />
{% endblock %}

{% block content %}
<div class="home-wrapper">
    
    <div class="banner-box">
        <div class="banner-text">
            <h1>Fresh Groceries</h1>
            <p>From our warehouse to your house.</p>
            <a href="/product-list" class="shop-link">View All Products</a>
        </div>
    </div>

    <div class="content-area">
        <div class="button-row">
            <div class="action-card">
                <div class="placeholder-icon"></div> <div>Repeat Last Order</div>
            </div>
            <div class="action-card">
                <div class="placeholder-icon"></div> <div>Saved Baskets</div>
            </div>
            <div class="action-card">
                <div class="placeholder-icon"></div> <div>Loyalty Card</div>
            </div>
        </div>

        <div class="category-area">
            <div class="category-title-bar">
                <h2>Shop By Category | <a href="/product-list">All products ></a></h2>
            </div>

            <div class="grid-container">
                <a href="/product-list?category=fruit" class="cat-item">
                    <div class="image-square"></div> <span>Fruit & Veg</span>
                </a>
                <a href="/product-list?category=dairy" class="cat-item">
                    <div class="image-square"></div> <span>Dairy</span>
                </a>
                <a href="/product-list?category=bakery" class="cat-item">
                    <div class="image-square"></div> <span>Bakery</span>
                </a>
                <a href="/product-list?category=meat" class="cat-item">
                    <div class="image-square"></div> <span>Meat & Fish</span>
                </a>
                <a href="/product-list?category=snacks" class="cat-item">
                    <div class="image-square"></div> <span>Snacks</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}