{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/home.css" />
{% endblock %}

{% block content %}
<div class="home-wrapper">

    <div class="banner-box">
        <div class="banner-text">
            <h1>Fresh Groceries</h1>
            <p>From our warehouse to your house.</p>
            <a href="/products" class="shop-link">View All Products</a>
        </div>
    </div>

    <div class="content-area">
        <div class="button-row">
            <div class="action-card">
                <div class="placeholder-icon"></div> <div>Repeat Last Order</div>
            </div>
            <div class="action-card">
                <div class="placeholder-icon"></div> <div>Saved Baskets</div>
            </div>
            {% if user %}
            <a href="/loyalty" class="action-card">
                <div class="placeholder-icon"></div> <div>Loyalty Card</div>
            </a>
            {% else %}
            <a href="/login" class="action-card">
                <div class="placeholder-icon"></div> <div>Loyalty Card</div>
            </a>
            {% endif %}
        </div>

        <div class="category-area">
            <div class="category-title-bar">
                <h2>Shop By Category | <a href="/products">All products ></a></h2>
            </div>

            <div class="grid-container">
                <a href="/products?category=Groceries%20%26%20Essentials" class="cat-item">
                    <div class="image-square"></div> <span>Groceries & Essentials</span>
                </a>

                <a href="/products?category=Fresh%20Food" class="cat-item">
                    <div class="image-square"></div> <span>Fresh Food</span>
                </a>

                <a href="/products?category=Bakery" class="cat-item">
                    <div class="image-square"></div> <span>Bakery</span>
                </a>

                <a href="/products?category=Frozen%20Food" class="cat-item">
                    <div class="image-square"></div> <span>Frozen Food</span>
                </a>

                <a href="/products?category=Treats%20%26%20Snacks" class="cat-item">
                    <div class="image-square"></div> <span>Treats & Snacks</span>
                </a>

                <a href="/products?category=Drinks" class="cat-item">
                    <div class="image-square"></div> <span>Drinks</span>
                </a>

                <a href="/products?category=Baby%20%26%20Toddler" class="cat-item">
                    <div class="image-square"></div> <span>Baby & Toddler</span>
                </a>

                <a href="/products?category=Health%20%26%20Beauty" class="cat-item">
                    <div class="image-square"></div> <span>Health & Beauty</span>
                </a>

                <a href="/products?category=Pets" class="cat-item">
                    <div class="image-square"></div> <span>Pets</span>
                </a>

                <a href="/products?category=Household%20%26%20Cleaning" class="cat-item">
                    <div class="image-square"></div> <span>Household & Cleaning</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
