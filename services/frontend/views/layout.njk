<!DOCTYPE html>
<html>
<head>
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/layout.css" />
  {% block styles %}
  {% endblock %}
</head>
<body>
    <div class = "header">
        <div>
            <a href = "/"> LOGO </a>
        </div>
        <div>
            <input class = "search" type = "text" placeholder = "Search" />
        </div>
        <div>
          {% if user %}
            <span>Hello, {{ user.first_name }} {{user.last_name}}</span>
            <form action="/logout" method="POST" style="display:inline;">
              <button type="submit">Logout</button>
            </form>
          {% else %}
            <a href = "/login"> Login </a>
            <a href = "/register"> Register </a>
          {% endif %}
            <a href = "/basket"> Basket </a>
        </div>
    </div>

    {% block content %} {% endblock %}

    {% block scripts %}
    {% if user %}
    <script>
      window.user = {{ user | dump | safe }};
    </script>
    <script type="module">
      import * as service from '/service.js';
      import * as api from '/api.js';

      (async () => {
        // Step 1: On first login in this session, merge guest items into DB
        if (!sessionStorage.getItem('synced')) {
          await service.syncBasketWithServer(api, window.user.id);
          sessionStorage.setItem('synced', 'true');
        }

        // Step 2: Always load the current DB basket into localStorage
        // This ensures fresh data on every page load or new tab
        await service.loadBasketFromServer(api, window.user.id);
      })();
    </script>
    {% endif %}
    {% endblock %}
</body>
</html>
