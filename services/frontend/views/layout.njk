<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | Supermarket</title>
  <link rel="icon" type="image/png" href="/images/title-logo.png">
  <link rel="stylesheet" href="/layout.css" />
  <link rel="stylesheet" href="/account.css" />

  {% block styles %}
  {% endblock %}
</head>

<body
  data-user-id="{% if user %}{{ user.id }}{% endif %}"
  data-user-first-name="{% if user %}{{ user.first_name or user.firstName }}{% endif %}"
>
  <header class="header">
    <a href="#main-content" class="skip">Skip to main content</a>
    <div class="logo">
      {% if user and (user.admin_level | default(0)) > 0 %}
        <a href="/staff-portal">
          <img src="/images/logo.png" alt="Group 44 Supermarket Logo">
        </a>
      {% else %}
        <a href="/">
          <img src="/images/logo.png" alt="Group 44 Supermarket Logo">
        </a>
      {% endif %}
    </div>

    <form action="/products" method="GET" role="search">
      <label for="site-search" class="visually-hidden">Search for products</label>
      <input
        id="site-search"
        class="search"
        type="text"
        name="q"
        placeholder="Search all products..."
      />
      <button type="submit">Search</button>
    </form>

    <nav class="user-actions" aria-label="Primary navigation">
      {% if user %}
        <span>Hello, {{ user.first_name or user.firstName }} {{ user.last_name or user.lastName }}</span>

        {% if (user.admin_level | default(0)) == 0 %}
          <a href="/account" class="login-link">My Account</a>
        {% endif %}

        <form action="/logout" method="POST" style="display:inline;">
          <button type="submit" class="logout-button">Logout</button>
        </form>
      {% else %}
        <a href="/login" class="login-link">Login</a>
        <a href="/register" class="register-link">Register</a>
      {% endif %}

      {% if user and (user.admin_level | default(0)) > 0 %}
        <a href="/staff-portal" class="login-link" aria-label="Staff Portal">Staff Portal</a>
      {% else %}
        <a href="/basket" class="basket-link" aria-label="Basket">
          <span class="basket-link-text">Basket</span>
          <span id="basket-count" aria-hidden="true">0</span>
        </a>
      {% endif %}
    </nav>

    <div class="trust-bar" aria-label="Our guarantees">
      <div class="full-text">📍 Delivering to Leeds, UK</div>
      <div class="short-text">📍 Leeds, UK</div>

      <div class="trust-slider">
        <div class="trust-item" aria-label="Freshness Guaranteed">🍎 Freshness Guaranteed</div>
        <div class="trust-item" aria-label="Next Day Delivery">🚚 Next Day Delivery</div>
        <div class="trust-item" aria-label="Secure Checkout">🛡️ Secure Checkout</div>
      </div>
    </div>
  </header>

  <div id="basket-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>

  <main id="main-content">
    {% block content %}{% endblock %}
  </main>

  {% if not user or (user.admin_level | default(0)) < 1 %}
    <section
      id="shopping-list-widget"
      class="shopping-list-widget"
      aria-label="Shopping list"
    >
      <button id="shopping-list-toggle" class="shopping-list-toggle" type="button">
        Shopping List
      </button>

      <div
        id="shopping-list-panel"
        class="shopping-list-panel hidden"
        aria-labelledby="shopping-list-title"
      >
        <div class="shopping-list-header">
          <h2 id="shopping-list-title">Your Shopping List</h2>
          <button
            id="shopping-list-close"
            type="button"
            aria-label="Close shopping list"
          >
            ×
          </button>
        </div>

        <div class="shopping-list-search">
          <label for="shopping-list-input" class="visually-hidden">
            Type a product name to add to list
          </label>
          <input
            id="shopping-list-input"
            type="text"
            placeholder="Type a product name..."
            autocomplete="off"
          />
          <div id="shopping-list-suggestions" class="shopping-list-suggestions"></div>
        </div>

        <div id="shopping-list-items" class="shopping-list-items"></div>
      </div>
    </section>
  {% endif %}

  <script type="module" src="/shoppingList.js"></script>
  <noscript> <META HTTP-EQUIV="Refresh" CONTENT="0;URL=nojs"> </noscript>
</body>
</html>
