<!DOCTYPE html>
<html>
<head>
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/layout.css" />
  {% block styles %}
  {% endblock %}
</head>
<body>
    <div class = "header">
        <div>
            <a href = "/"> LOGO </a>
        </div>
        <div>
            <input class = "search" type = "text" placeholder = "Search" />
        </div>
        <div>
          {% if user %}
            <span>Hello, {{ user.first_name }} {{user.last_name}}</span>
            <form action="/logout" method="POST" style="display:inline;">
              <button type="submit">Logout</button>
            </form>
          {% else %}
            <a href = "/login"> Login </a>
            <a href = "/register"> Register </a>
          {% endif %}
            <a href = "/basket"> Basket </a>
        </div>
    </div>

    {% block content %} {% endblock %}

    {% block scripts %}
    {% if user %}
    <script>
      window.user = {{ user | dump | safe }};
    </script>
    <script type="module">
      import * as service from '/service.js';
      import { api } from '/api.js';

      (async () => {
        try {
          console.log('🔵 Layout sync started for user:', window.user.id);

          const localItems = service.getBasket();
          console.log('  Local basket items:', localItems.length);

          // Step 1: If there are guest items in localStorage, merge them first
          if (localItems.length > 0) {
            console.log('  → Found', localItems.length, 'guest items, merging...');
            await service.syncBasketWithServer(api, window.user.id);
            console.log('  ✓ Guest items merged');
          } else {
            console.log('  → No guest items to merge');
          }

          // Step 2: Always load the current DB basket into localStorage
          // This ensures we have the authoritative state from the server
          console.log('  → Loading DB basket into localStorage...');
          await service.loadBasketFromServer(api, window.user.id);
          console.log('  ✓ DB basket loaded');

          const currentBasket = service.getBasket();
          console.log('  Final basket:', currentBasket.length, 'items');
        } catch (error) {
          console.error('✗ Sync error:', error);
        }
      })();
    </script>
    {% endif %}
    {% endblock %}
</body>
</html>
