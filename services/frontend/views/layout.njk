<!DOCTYPE html>
<html>
<head>
  <title>{{ title }} | Supermarket</title>
  <link rel="stylesheet" href="/layout.css" />
  {% block styles %}
  {% endblock %}
</head>
<body
  data-user-id="{{ user.id if user else '' }}"
  data-user-first-name="{{ user.firstName if user else '' }}"
>
    <div class = "header">
        <div class = "logo">
            <a href = "/">Supermarket</a>
        </div>
        <div>
            <input class = "search" type = "text" placeholder = "Search" />
        </div>
        <div class = "user-actions">
          {% if user %}
            <span>Hello, {{ user.first_name }} {{user.last_name}}</span>
            <form action="/logout" method="POST" style="display:inline;">
              <button type="submit" class = "logout-button">Logout</button>
            </form>
          {% else %}
            <a href = "/login">Login</a>
            <a href = "/register">Register</a>
          {% endif %}
            <a href = "/basket">Basket</a>
        </div>
    </div>

    <div id="shopping-list-widget" class="shopping-list-widget">
      <button id="shopping-list-toggle" class="shopping-list-toggle" type="button">Shopping List</button>

      <div id="shopping-list-panel" class="shopping-list-panel hidden">
        <div class="shopping-list-header">
          <h3>Your Shopping List</h3>
          <button id="shopping-list-close" type="button">x</button>
        </div>

        <div class="shopping-list-search">
          <input id="shopping-list-input" type="text" placeholder="Type a product name..." autocomplete="off" />
          <div id="shopping-list-suggestions" class="shopping-list-suggestions"></div>
        </div>

        <div id="shopping-list-items" class="shopping-list-items"></div>
      </div>
    </div>

    {% block content %} {% endblock %}
    <script type="module" src="/shoppingList.js"></script>
</body>
</html>
