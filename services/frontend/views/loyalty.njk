{% extends "layout.njk" %}

{% block styles %}
<link rel="stylesheet" href="/home.css" />
<link rel="stylesheet" href="/loyalty.css" />
{% endblock %}

{% block content %}
<div class="home-wrapper">
  <div class="banner-box">
    <div class="banner-text">
      <h1>Your Loyalty Card</h1>
      <p>Earn points for every purchase and climb the loyalty tiers.</p>
    </div>
  </div>

  <div class="content-area">
    <div class="action-card">
      <h2><span class="tier-badge tier-{{ account.tier|lower }}">{{ account.tier }}</span> member</h2>
      <p><strong>{{ account.points }}</strong> points</p>
      <p>Account created: {{ account.created_at | formatDate }}</p>
      
      {% if account.benefits %}
      <div class="benefits-grid">
        <div class="benefit-card">
          <h3>Points Earned</h3>
          <div class="value">{{ account.benefits.points_per_pound }} / &pound;1</div>
          <p>points per pound</p>
        </div>
        <div class="benefit-card">
          <h3>Redemption Rate</h3>
          <div class="value">{{ account.benefits.redemption_rate }}</div>
          <p>points = &pound;1 off</p>
        </div>
        <div class="benefit-card">
          <h3>Upgrade Coupons</h3>
          <div class="value">{{ account.benefits.coupon_on_upgrade }}</div>
          <p>on tier upgrade</p>
        </div>
      </div>
      {% endif %}
    </div>

    {% if account.tier == "Bronze" %}
    {% set next_tier = "Silver" %}
    {% set next_tier_point_target = 2000 %}
    {% elif account.tier == "Silver" %}
    {% set next_tier = "Gold" %}
    {% set next_tier_point_target = 5000 %}
    {% else %}
    {% set next_tier = null %}
    {% endif %}

    {% if next_tier %}
    <div class="progress-section">
      <h3>Progress to {{ next_tier }}</h3>
      {% set progress = (account.points / next_tier_point_target * 100)|round %}
      {% if progress > 100 %}
      {% set progress = 100 %}
      {% endif %}
      <div class="progress-bar">
        <div class="progress-fill" style="width: {{ progress }}%"></div>
      </div>
      <p>{{ account.points }} / {{ next_tier_point_target }} points ({{ progress }}%)</p>
    </div>
    {% endif %}

    <!-- Available Coupons -->
    {% if account.coupons and account.coupons|length > 0 %}
    <div class="category-area coupons-section">
      <div class="category-title-bar">
        <h2>Your Coupons</h2>
        <p>Loyalty coupons are applied from the basket loyalty section. They are separate from promo codes.</p>
      </div>
      {% for coupon in account.coupons %}
      <div class="coupon-card {% if coupon.used_at %}coupon-used{% endif %}">
        <div>
          <span class="coupon-code">{{ coupon.code }}</span>
          <span class="coupon-discount"> - {{ coupon.discount_percent }}% off</span>
          <br>
          <span class="coupon-expires">
            {% if coupon.used_at %}
            Used on {{ coupon.used_at | formatDate }}
            {% else %}
            Min spend: &pound;{{ (coupon.min_spend_pence / 100) | toFixed(2) }} | Expires {{ coupon.expires_at | formatDate }}
            {% endif %}
          </span>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="category-area">
      <div class="category-title-bar">
        <h2>Recent Loyalty Activity</h2>
      </div>

      {% if account.transactions and account.transactions|length %}
        <div class="grid-container">
          <table class="loyalty-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Order</th>
                <th>Points</th>
              </tr>
            </thead>
            <tbody>
              {% for tx in account.transactions %}
                <tr>
                  <td>{{ tx.timestamp | formatDate }}</td>
                  <td>{{ tx.type }}</td>
                  <td>{% if tx.order_id %}{{ tx.order_id }}{% else %}N/A{% endif %}</td>
                  <td {% if tx.point_change < 0 %}style="color: red;"{% else %}style="color: green;"{% endif %}>
                    {{ tx.point_change }}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p>You have no loyalty transactions yet. Start shopping to earn points.</p>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
